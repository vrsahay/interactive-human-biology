.netrc

# --- local-only archive (development history kept on this machine, not published) ---
local-archive/

# --- test output and local QA artefacts -------------------------------------
web/.qa-audio/
docs/qa/captures/
*.log
*.log.jsonl
blender/.mcp-blender.pid
.tmp/
tmp/

