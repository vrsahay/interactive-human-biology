  "recall.water.question": {
   "url": "cue_recall_water_question.mp3",
   "bytes": 9504,
   "sha256": "5d9eb6f49c5a072e000d1f9ce9a13df091dc8028dd4ae13bc541690c9dc30675",
   "durationMs": 2200,
   "leadInMs": 0,
   "voice": "en-IN-Chirp3-HD-Aoede",
   "speakingRate": 1,
   "text": "How do plants get rid of excess water?"
  },
  "recall.water.reveal": {
   "url": "cue_recall_water_reveal.mp3",
   "bytes": 23136,
   "sha256": "c109a57b346229aae7016319210de343722853571857ea785741d2dd455d6f4f",
   "durationMs": 5280,
   "leadInMs": 0,
   "voice": "en-IN-Chirp3-HD-Aoede",
   "speakingRate": 1,
   "text": "Yes, that’s right. Excess water is lost as water vapour. This is transpiration."
  },
  "recall.oxygen.question": {
   "url": "cue_recall_oxygen_question.mp3",
   "bytes": 20064,
   "sha256": "5ce09a63950c3f7166bbee3c2958a264a2ef764f9451c17b5285206d60a26ebc",
   "durationMs": 4600,
   "leadInMs": 0,
   "voice": "en-IN-Chirp3-HD-Aoede",
   "speakingRate": 1,
   "text": "Which gas, made during photosynthesis, can be thought of as a waste product?"
  },
  "recall.oxygen.reveal": {
   "url": "cue_recall_oxygen_reveal.mp3",
   "bytes": 19776,
   "sha256": "c490912c268c37e28daa7c53c89344be3741db7a722107c89277f28b834ebd63",
   "durationMs": 4400,
   "leadInMs": 0,
   "voice": "en-IN-Chirp3-HD-Aoede",
   "speakingRate": 1,
   "text": "Yes, that’s right. Oxygen is made in photosynthesis and released into the air."
  },
  "recall.store.question": {
   "url": "cue_recall_store_question.mp3",
   "bytes": 13632,
   "sha256": "dd8e5076b0e31be9fd6c789e270315459ad79960481bca3ffd11dd05382cd71a",
   "durationMs": 3600,
   "leadInMs": 0,
   "voice": "en-IN-Chirp3-HD-Aoede",
   "speakingRate": 1,
   "text": "Where can many plant waste products be stored inside cells?"
