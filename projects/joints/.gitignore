qa/visual/

# ---- Step 17B: repository hygiene --------------------------------------------------------------
# Local credentials. The narration build reads its key from the TTS_KEY environment variable only;
# it is never written to a file. These patterns make sure a local one can never be committed.
.env
.env.*
!.env.example
*.pem
*.p12
*-service-account*.json
*credentials*.json

# Test and tool output (the committed evidence lives in qa/reports/, which is not affected)
blob-report/
coverage/
.cache/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
