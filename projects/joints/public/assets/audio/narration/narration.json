 "shots": {
  "intro.title": {
   "url": "intro.title.mp3",
   "bytes": 28512,
   "sha256": "cd7eb021999d31a09bcf6c158b5c4a99f7654912ead4d3c37dd5996b45489d20",
   "durationMs": 6160,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 8000,
   "budgetMs": 7250,
   "fits": true,
   "textKeys": [
    "narr.intro.title"
   ],
   "text": "Every time you move, bones move against each other at a joint. Different joints allow very different movements."
  },
  "hook.shoulder": {
   "url": "hook.shoulder.mp3",
   "bytes": 24864,
   "sha256": "75b0e35ea39c4b5bd4439b57bf4155fd13805de7aee8faa74abb19da7e756673",
   "durationMs": 5320,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6100,
   "budgetMs": 5350,
   "fits": true,
   "textKeys": [
    "narr.hook.shoulder"
   ],
   "text": "Start with the shoulder. Your arm can swing forward, out to the side, and round in a circle."
  },
  "hook.elbow": {
   "url": "hook.elbow.mp3",
   "bytes": 22272,
   "sha256": "6bcfaa86e9cd9aa62731ade7acf24001a7bd679d80cfb49abee455f380494b7a",
   "durationMs": 4960,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 5800,
   "budgetMs": 5050,
   "fits": true,
   "textKeys": [
    "narr.hook.elbow"
   ],
   "text": "Now the elbow, on the same arm. It does one thing: it bends and it straightens."
  },
  "hook.question": {
   "url": "hook.question.mp3",
   "bytes": 18624,
   "sha256": "6f9fc139d9d2c7d14a3dc6c7cb210398520b412536f3c09862e767ae3128f7c6",
   "durationMs": 4600,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 5500,
   "budgetMs": 4750,
   "fits": true,
   "textKeys": [
    "narr.hook.question"
   ],
   "text": "Both are joints in the same arm. So why does one move in every direction and the other in only one?"
  },
  "concept.meet": {
   "url": "concept.meet.mp3",
   "bytes": 27744,
   "sha256": "cac1383b3c9d40d863cc700ff2114cb67b0038629ed2cdfb033028797a02424b",
   "durationMs": 7480,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 8300,
   "budgetMs": 7550,
   "fits": true,
   "textKeys": [
    "narr.concept.meet"
   ],
   "text": "A joint is any place where bones meet. Most joints are two bones meeting; here at the elbow, three bones come together."
  },
  "concept.different": {
   "url": "concept.different.mp3",
   "bytes": 28512,
   "sha256": "9a7e3faad0d97cde1b0bf334d50314a3030c181cc7351b89aee1b4856d9c9549",
   "durationMs": 7080,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7900,
   "budgetMs": 7150,
   "fits": true,
   "textKeys": [
    "narr.concept.different"
   ],
   "text": "How the bones meet at a joint decides how that joint can move. Change the shape of the join and you change the movement."
  },
  "intro.map": {
   "url": "intro.map.mp3",
   "bytes": 24384,
   "sha256": "7474249b9c8fc90f7fdb70b383a2a364972de7d62885ed3b1cf3285377f1cc2c",
   "durationMs": 6560,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7400,
   "budgetMs": 6650,
   "fits": true,
   "textKeys": [
    "narr.intro.map"
   ],
   "text": "You have joints like these all over your body. We will look at four kinds, and at what each shape allows."
  },
  "fixed.travel": {
   "url": "fixed.travel.mp3",
   "bytes": 29376,
   "sha256": "77fc965feb1a8f09073538743a100c1a2d809957eb1f2e4be31fe69b44586a1e",
   "durationMs": 6800,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7600,
   "budgetMs": 6850,
   "fits": true,
   "textKeys": [
    "narr.fixed.travel"
   ],
   "text": "Go up to the top of the head. The skull looks like a single piece, but it is several separate bones meeting along wavy lines."
  },
  "fixed.bones": {
   "url": "fixed.bones.mp3",
   "bytes": 23712,
   "sha256": "a90bdb80b2d8ba98a6ce8e1a5d34b21def808f0e23dd7cf28518c2e15ca47f7f",
   "durationMs": 5840,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6600,
   "budgetMs": 5850,
   "fits": true,
   "textKeys": [
    "narr.fixed.bones"
   ],
   "text": "These are two of those bones, and this is the line where they meet. Look at how the edges follow each other."
  },
  "fixed.try": {
   "url": "fixed.try.mp3",
   "bytes": 21312,
   "sha256": "88190a3112b2081794dd057fefbcad3b5e098c8d533a03d928b5ce84e805f3c7",
   "durationMs": 4480,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6500,
   "budgetMs": 5750,
   "fits": true,
   "textKeys": [
    "narr.fixed.try"
   ],
   "text": "Watch the join itself. Nothing slides, nothing bends, nothing shifts at all."
  },
  "fixed.why": {
   "url": "fixed.why.mp3",
   "bytes": 33216,
   "sha256": "386691791532f4795d78dd28b15f2967967b0cf59f6ee670263565b9e5d30489",
   "durationMs": 8240,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 9000,
   "budgetMs": 8250,
   "fits": true,
   "textKeys": [
    "narr.fixed.why"
   ],
   "text": "The edges of these bones lock into each other, and tough fibres hold them tightly together. There is no gap for them to slide in, so they cannot move against each other."
  },
  "fixed.name": {
   "url": "fixed.name.mp3",
   "bytes": 37344,
   "sha256": "b24cc4d54a29bf3eb057fa10f7e8b9a269dab8f2d1b4a62009282bf71e630f47",
   "durationMs": 10080,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 10900,
   "budgetMs": 10150,
   "fits": true,
   "textKeys": [
    "narr.fixed.name"
   ],
   "text": "A join that holds two bones still like this is called a fixed joint. Its job is strength, not movement: together these bones make one solid case around the brain."
  },
  "fixed.task": {
   "url": "fixed.task.mp3",
   "bytes": 19776,
   "sha256": "f554b6313f2b4457810435c17e1dbc5a2b6eac7d845b7791805128e380e18237",
   "durationMs": 4440,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 5200,
   "budgetMs": 4450,
   "fits": true,
   "textKeys": [
    "narr.fixed.task"
   ],
   "text": "Try it yourself. See whether you can move these two bones apart."
  },
  "pivot.travel": {
   "url": "pivot.travel.mp3",
   "bytes": 19296,
   "sha256": "809d8a928bfeea06c0c1ca0ad347344a9e4cc26376c169a09056cb0bbc9ee511",
   "durationMs": 4760,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6000,
   "budgetMs": 5250,
   "fits": true,
   "textKeys": [
    "narr.pivot.travel"
   ],
   "text": "Now down to the top of the neck, just under the skull, where the head meets the backbone."
  },
  "pivot.bones": {
   "url": "pivot.bones.mp3",
   "bytes": 31872,
   "sha256": "34c72a251a7320d7ea5f16b06252b3bf1ea4be4df2755cc8d142fed61c97dccb",
   "durationMs": 6800,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7600,
   "budgetMs": 6850,
   "fits": true,
   "textKeys": [
    "narr.pivot.bones"
   ],
   "text": "At the top of the neck, one small bone sits on top of another. Nothing is moving yet. The lower bone is the one that stays still."
  },
  "pivot.rotate": {
   "url": "pivot.rotate.mp3",
   "bytes": 16992,
   "sha256": "a0f6035a8d225319c1b13a9ecdbfb6b07d5788a3887e492c3366932fe9c2f2e4",
   "durationMs": 4320,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7500,
   "budgetMs": 6750,
   "fits": true,
   "textKeys": [
    "narr.pivot.rotate"
   ],
   "text": "Now the upper bone turns around the one below it, and your head turns with it."
  },
  "pivot.why": {
   "url": "pivot.why.mp3",
   "bytes": 41472,
   "sha256": "a6dcd14a6215116579b25d407be7b40750cd6f84b50df059d295848c91566fc7",
   "durationMs": 10320,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 11100,
   "budgetMs": 10350,
   "fits": true,
   "textKeys": [
    "narr.pivot.why"
   ],
   "text": "The upper bone turns around one line running straight up through both bones. Turning around that line is the only movement this shape allows, which is why the head swivels here rather than bending."
  },
  "pivot.name": {
   "url": "pivot.name.mp3",
   "bytes": 18336,
   "sha256": "9a732956a0044a0321d2384e0bb300a53af1bcd65967919629d774ea3ca83fc4",
   "durationMs": 4080,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6000,
   "budgetMs": 5250,
   "fits": true,
   "textKeys": [
    "narr.pivot.name"
   ],
   "text": "A joint where one bone turns around another like this is called a pivot joint."
  },
  "pivot.task": {
   "url": "pivot.task.mp3",
   "bytes": 16512,
   "sha256": "f398c25e24f70a468d1dd3666a56de0330a25f1fd9ee2188f73b7e74355697d2",
   "durationMs": 4080,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 5000,
   "budgetMs": 4250,
   "fits": true,
   "textKeys": [
    "narr.pivot.task"
   ],
   "text": "Try it yourself. Turn the head as if you were looking over one shoulder."
  },
  "ball.travel": {
   "url": "ball.travel.mp3",
   "bytes": 12672,
   "sha256": "4e1a656399c4af60ecc4477ace87abd0605fd902a7deb0c0f2d636b51666d7e1",
   "durationMs": 3800,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6000,
   "budgetMs": 5250,
   "fits": true,
   "textKeys": [
    "narr.ball.travel"
   ],
   "text": "Back up to the shoulder, where the arm meets the body."
  },
  "ball.bones": {
   "url": "ball.bones.mp3",
   "bytes": 30624,
   "sha256": "5d00c0913cd2b9eda527d99cb2b4179251a3d07a139cee27f2fecec79ba3241e",
   "durationMs": 8160,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 9000,
   "budgetMs": 8250,
   "fits": true,
   "textKeys": [
    "narr.ball.bones"
   ],
   "text": "The top of the upper-arm bone is a smooth, rounded ball. Beside it, the shoulder blade has a shallow hollow, and the ball rests in it."
  },
  "ball.move": {
   "url": "ball.move.mp3",
   "bytes": 28224,
   "sha256": "abefde71f2843e909a963381370b6103b624f11c0d1c38ae317f13f6a11b1afa",
   "durationMs": 6720,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7500,
   "budgetMs": 6750,
   "fits": true,
   "textKeys": [
    "narr.ball.move"
   ],
   "text": "From this one joint, the arm can move in many directions: forward, backwards, out sideways, and right round."
  },
  "ball.why": {
   "url": "ball.why.mp3",
   "bytes": 40032,
   "sha256": "e7402f05e6e1527b3206a924e54894206c59157585dcf2c9d067e1003d955282",
   "durationMs": 10120,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 10900,
   "budgetMs": 10150,
   "fits": true,
   "textKeys": [
    "narr.ball.why"
   ],
   "text": "A rounded end sitting in a hollow can roll and turn in every direction at once. Nothing holds it to a single line, so the arm is not limited to one direction the way the elbow is."
  },
  "ball.name": {
   "url": "ball.name.mp3",
   "bytes": 19392,
   "sha256": "87c7871c28d6af8ace4c2a594793505956191b8a641e10b55b3da1845de7e7e7",
   "durationMs": 4240,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6000,
   "budgetMs": 5250,
   "fits": true,
   "textKeys": [
    "narr.ball.name"
   ],
   "text": "A rounded end sitting in a hollow like this is called a ball-and-socket joint."
  },
  "ball.task": {
   "url": "ball.task.mp3",
   "bytes": 17376,
   "sha256": "a41930a629d6bfb8cdb6aa0c7f64bb09935d3cc5c47af4a89438c6003e4ee079",
   "durationMs": 4640,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 5400,
   "budgetMs": 4650,
   "fits": true,
   "textKeys": [
    "narr.ball.task"
   ],
   "text": "Try it yourself. Move the arm in two different directions."
  },
  "hinge.travel": {
   "url": "hinge.travel.mp3",
   "bytes": 11712,
   "sha256": "fff143bdddc2ec76c797c1ab5f730242f67a8c7008592113f46c5e7008665827",
   "durationMs": 3160,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6000,
   "budgetMs": 5250,
   "fits": true,
   "textKeys": [
    "narr.hinge.travel"
   ],
   "text": "Down the same arm now, to the elbow."
  },
  "hinge.source": {
   "url": "hinge.source.mp3",
   "bytes": 19296,
   "sha256": "e9d08e78a273175512307b731d59a1ede66cc2383b9d24ab109ec0302ead26ee",
   "durationMs": 4880,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7500,
   "budgetMs": 6750,
   "fits": true,
   "textKeys": [
    "narr.hinge.source"
   ],
   "text": "The elbow bends and straightens in one direction, the way a door swings on its hinges."
  },
  "hinge.bones": {
   "url": "hinge.bones.mp3",
   "bytes": 15456,
   "sha256": "ac202e8eebcbd0ecfc7d50359e22156fa90e088c93ffcf4209e24ab522685319",
   "durationMs": 3840,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7000,
   "budgetMs": 6250,
   "fits": true,
   "textKeys": [
    "narr.hinge.bones"
   ],
   "text": "The elbow is where the upper-arm bone meets two bones in the forearm."
  },
  "hinge.axis": {
   "url": "hinge.axis.mp3",
   "bytes": 24864,
   "sha256": "cc8599509898cd805df35f39cefc916a35cfdcd16ddb623412288ac5e55e3704",
   "durationMs": 5520,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 7000,
   "budgetMs": 6250,
   "fits": true,
   "textKeys": [
    "narr.hinge.axis"
   ],
   "text": "This blue line shows the direction the elbow bends around. We call that line the axis."
  },
  "hinge.flexion": {
   "url": "hinge.flexion.mp3",
   "bytes": 24096,
   "sha256": "f4d93a55868d22d01955dd06e77581adb5ea35c574d994f62c675f17b81a6b24",
   "durationMs": 4680,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 9500,
   "budgetMs": 8750,
   "fits": true,
   "textKeys": [
    "narr.hinge.flexion"
   ],
   "text": "Watch the forearm come up. When the elbow bends like this, the movement is called flexion."
  },
  "hinge.extension": {
   "url": "hinge.extension.mp3",
   "bytes": 18912,
   "sha256": "45dfdfc28dcf88d8658b1afe723e4264d660f05b0f27977abb980928e6b5d06e",
   "durationMs": 4680,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 9500,
   "budgetMs": 8750,
   "fits": true,
   "textKeys": [
    "narr.hinge.extension"
   ],
   "text": "And as it straightens again, that movement is called extension."
  },
  "hinge.why": {
   "url": "hinge.why.mp3",
   "bytes": 49344,
   "sha256": "48f9ad255efbb081c9f648c059fb3d666a31929de5e1a9dbced2f8ff7bef5b86",
   "durationMs": 12280,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 13100,
   "budgetMs": 12350,
   "fits": true,
   "textKeys": [
    "narr.hinge.why"
   ],
   "text": "Look at the shape of the join. The end of the upper-arm bone is like a spool, and the forearm bone wraps around it. A spool can only turn about its own line, so the elbow can only bend and straighten."
  },
  "hinge.name": {
   "url": "hinge.name.mp3",
   "bytes": 19872,
   "sha256": "58dab3fb0a2176a6c8f2477cca45822b22b9cdcf65764c5ee59171b6f3d4747a",
   "durationMs": 4840,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6000,
   "budgetMs": 5250,
   "fits": true,
   "textKeys": [
    "narr.hinge.name"
   ],
   "text": "A joint that bends and straightens around one line like this is called a hinge joint."
  },
  "hinge.try": {
   "url": "hinge.try.mp3",
   "bytes": 19776,
   "sha256": "31342f45317f7f93431e2cfe5aec63c1d45ad68278a8ead31c287fac850680e8",
   "durationMs": 4880,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 14000,
   "budgetMs": 13250,
   "fits": true,
   "textKeys": [
    "hinge.try",
    "hinge.try_prompt"
   ],
   "text": "Your turn: bend and straighten the elbow. Drag the forearm, or use the slider."
  },
  "hinge.check": {
   "url": "hinge.check.mp3",
   "bytes": 15072,
   "sha256": "eda523dda74130bfa229afb065fdafc1a4bca7ee99803b3dd09ed22d3f09cfac",
   "durationMs": 3720,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 14000,
   "budgetMs": 13250,
   "fits": true,
   "textKeys": [
    "check.prompt"
   ],
   "text": "Try it: bend the elbow to about 90°."
  },
  "hinge.support": {
   "url": "hinge.support.mp3",
   "bytes": 27552,
   "sha256": "6b39d6fc1a2c05f17a34a2aa27733fb42a2ff7cd64321c3cd45a9626c2200f6e",
   "durationMs": 6680,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 9500,
   "budgetMs": 8750,
   "fits": true,
   "textKeys": [
    "narr.hinge.support"
   ],
   "text": "A joint capsule and ligaments wrap around the elbow. They hold the bones together and keep the movement on that one line."
  },
  "hinge.return": {
   "url": "hinge.return.mp3",
   "bytes": 9696,
   "sha256": "ddf048a6f0dee7c70a9b034664065fd8049947981cab8680f343a92cd1bde75e",
   "durationMs": 2000,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 4600,
   "budgetMs": 3850,
   "fits": true,
   "textKeys": [
    "narr.hinge.return"
   ],
   "text": "The elbow settles back to rest."
  },
  "hinge.knee": {
   "url": "hinge.knee.mp3",
   "bytes": 23424,
   "sha256": "f35457bbc052821b09f480c907d3a516d6f230e0cf466ccedd324ced99712953",
   "durationMs": 6120,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 8500,
   "budgetMs": 7750,
   "fits": true,
   "textKeys": [
    "narr.hinge.knee"
   ],
   "text": "The knee is another hinge joint. It is bigger, but it does the same thing: it bends and straightens one way."
  },
  "compare.pullback": {
   "url": "compare.pullback.mp3",
   "bytes": 18144,
   "sha256": "b19031ea4dc3ef334025cdd781d593f908b35b22b590085fd062202f00e44ec7",
   "durationMs": 5920,
   "speakingRate": 1,
   "leadInMs": 350,
   "shotDurationMs": 6700,
   "budgetMs": 5950,
   "fits": true,
   "textKeys": [
    "narr.compare.pullback"
   ],
   "text": "Four joints, in one body, with four different ways of moving. Look at each one again."
  },
  "compare.fixed": {
   "url": "compare.fixed.mp3",
