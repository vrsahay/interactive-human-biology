 "reasons": [
  {
   "chapter": "fixed",
   "shot": "fixed.why",
   "words": 36,
   "text": "Why they cannot move The edges of these bones lock into each other, and tough fibres hold them tightly together. There is no gap for them to slide in, so they cannot move against each other.",
   "spoken": true
  },
  {
   "chapter": "pivot",
   "shot": "pivot.why",
   "words": 38,
   "text": "Turning, and nothing else The upper bone turns around one line running straight up through both bones. Turning around that line is the only movement this shape allows, which is why the head swivels here rather than bending.",
   "spoken": true
  },
  {
   "chapter": "ball_socket",
   "shot": "ball.why",
   "words": 42,
   "text": "Why it moves so freely A rounded end sitting in a hollow can roll and turn in every direction at once. Nothing holds it to a single line, so the arm is not limited to one direction the way the elbow is.",
   "spoken": true
  },
  {
   "chapter": "hinge",
   "shot": "hinge.why",
   "words": 47,
   "text": "Why it bends only one way Look at the shape of the join. The end of the upper-arm bone is like a spool, and the forearm bone wraps around it. A spool can only turn about its own line, so the elbow can only bend and straighten.",
   "spoken": true
  }
 ],
