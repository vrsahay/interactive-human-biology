   ],
   "spoken": true
  },
  {
   "key": "compare.fixed",
   "text": "Fixed: almost no movement at all.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.fixed caption text"
   ],
   "spoken": true
  },
  {
   "key": "compare.hinge",
   "text": "Hinge: bending and straightening one way.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.hinge caption text"
   ],
   "spoken": true
  },
  {
   "key": "compare.intro",
   "text": "Four joints. Four different ways of moving.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.pullback caption text"
   ],
   "spoken": true
  },
  {
   "key": "compare.pivot",
   "text": "Pivot: turning around the bone below.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.pivot caption text"
   ],
   "spoken": true
  },
  {
   "key": "compare.together",
   "text": "The type of joint tells you the pattern of movement.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.together caption text"
   ],
   "spoken": true
  },
  {
   "key": "concept.different",
   "text": "The way the bones meet decides how they can move.",
   "provenance": "draft-enrichment",
   "where": [
    "concept.different caption text"
   ],
   "spoken": true
  },
  {
   "key": "concept.meet",
   "text": "A joint is a place where two bones meet.",
   "provenance": "draft-enrichment",
   "where": [
    "concept.meet caption text"
   ],
   "spoken": true
  },
  {
   "key": "explore.ball.explanation",
   "text": "The arm moves in many directions, not just one. That is a ball-and-socket joint.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.ball explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.ball.instruction",
   "text": "Drag in any direction to move the arm.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.ball instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.fixed.explanation",
   "text": "These bones barely move. A fixed joint holds bones firmly together.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.fixed explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.fixed.instruction",
   "text": "Try to move the skull bones.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.fixed instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.hinge.explanation",
   "text": "Bending is flexion. Straightening is extension. A hinge joint does both, in one direction.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.hinge explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.hinge.instruction",
   "text": "Drag to bend and straighten the elbow.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.hinge instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.pivot.explanation",
   "text": "The head turns around the bone below it. A pivot joint allows rotation.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.pivot explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.pivot.instruction",
   "text": "Drag left and right to turn the head.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.pivot instruction"
   ],
   "spoken": true
  },
  {
   "key": "fixed.text",
   "text": "The bones of the skull meet at fixed joints. These bones do not move against each other.",
