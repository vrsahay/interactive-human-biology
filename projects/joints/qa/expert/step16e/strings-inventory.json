   ],
   "spoken": false
  },
  {
   "key": "ball.why.head",
   "text": "Why it moves so freely",
   "provenance": "draft-enrichment",
   "where": [
    "ball.why caption title"
   ],
   "spoken": false
  },
  {
   "key": "check.correct",
   "text": "That is about 90°. Well done.",
