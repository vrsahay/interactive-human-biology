   ],
   "spoken": true
  },
  {
   "key": "compare.intro",
   "text": "Four joints. Four different ways of moving.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.pullback caption text"
   ],
   "spoken": false
  },
  {
   "key": "compare.together",
   "text": "The type of joint tells you the pattern of movement.",
   "provenance": "draft-enrichment",
   "where": [
    "compare.together caption text"
   ],
   "spoken": false
  },
  {
   "key": "concept.different",
   "text": "The way the bones meet decides how they can move.",
   "provenance": "draft-enrichment",
   "where": [
    "concept.different caption text"
   ],
   "spoken": false
  },
  {
   "key": "concept.meet",
   "text": "A joint is a place where bones meet.",
   "provenance": "draft-enrichment",
   "where": [
    "concept.meet caption text"
   ],
   "spoken": false
  },
  {
   "key": "explore.ball.done",
   "text": "One joint, more than one direction. That is a ball-and-socket joint.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.ball task done"
   ],
   "spoken": true
  },
  {
   "key": "explore.ball.explanation",
   "text": "The arm moves in many directions, not just one. That is a ball-and-socket joint.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.ball explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.ball.instruction",
   "text": "Drag in any direction to move the arm.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.ball instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.ball.task",
   "text": "Move the arm in two different directions.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.ball task"
   ],
   "spoken": true
  },
  {
   "key": "explore.fixed.done",
   "text": "They barely move, and they spring straight back. That is a fixed joint.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.fixed task done"
   ],
   "spoken": true
  },
  {
   "key": "explore.fixed.explanation",
   "text": "These bones barely move. A fixed joint holds bones firmly together.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.fixed explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.fixed.instruction",
   "text": "Try to move the skull bones.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.fixed instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.fixed.task",
   "text": "Try to move the two skull bones apart.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.fixed task"
   ],
   "spoken": true
  },
  {
   "key": "explore.hinge.done",
   "text": "That is flexion. Straighten it again and that is extension — one line, two directions.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.hinge task done"
   ],
   "spoken": true
  },
  {
   "key": "explore.hinge.explanation",
   "text": "Bending is flexion. Straightening is extension. A hinge joint does both, in one direction.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.hinge explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.hinge.instruction",
   "text": "Drag to bend and straighten the elbow.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.hinge instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.hinge.task",
   "text": "Bend the elbow until it is about half-way — around 90 degrees.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.hinge task"
   ],
   "spoken": true
  },
  {
   "key": "explore.pivot.done",
   "text": "The head turned, and the bone below stayed still. That is a pivot joint.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.pivot task done"
   ],
   "spoken": true
  },
  {
   "key": "explore.pivot.explanation",
   "text": "The head turns around the bone below it. A pivot joint allows rotation.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.pivot explanation"
   ],
   "spoken": false
  },
  {
   "key": "explore.pivot.instruction",
   "text": "Drag left and right to turn the head.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.pivot instruction"
   ],
   "spoken": true
  },
  {
   "key": "explore.pivot.task",
   "text": "Turn the head as if you were looking over one shoulder.",
   "provenance": "draft-enrichment",
   "where": [
    "explore.pivot task"
   ],
   "spoken": true
  },
  {
   "key": "fixed.bones.head",
   "text": "Two bones, one join",
   "provenance": "draft-enrichment",
   "where": [
    "fixed.bones caption title"
   ],
   "spoken": false
  },
  {
