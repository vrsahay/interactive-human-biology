{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "joints-platform/joint-manifest.schema.json",
  "title": "Joint manifest (schema 1)",
  "type": "object",
  "required": ["schema", "jointId", "jointName", "jointType", "side", "coordinateSystem", "pivot", "controller", "dofs", "semantics", "structures", "anchors", "bands",
               "bandRepresentation", "registry", "motion", "tiers", "budgetsKB", "source", "meshConvention", "compression", "sharedTextures", "generatedAt"],
  "properties": {
    "schema": { "const": 1 },
    "jointId": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "jointName": { "type": "string" },
    "jointType": { "enum": ["hinge", "ball_socket", "pivot", "fixed", "gliding"] },
    "side": { "enum": ["right", "left", "midline"] },
    "coordinateSystem": { "type": "object", "required": ["space", "up", "units"], "properties": { "space": { "const": "glTF" }, "up": { "const": "+Y" }, "units": { "const": "metres" } } },
    "pivot": { "type": "object", "required": ["node", "point", "flexionAxisWorld", "trueExtensionForearmDirWorld", "flexionTravelDirWorld", "method"],
      "properties": { "node": { "type": "string" }, "point": { "$ref": "#/definitions/vec3" }, "flexionAxisWorld": { "$ref": "#/definitions/vec3" },
                      "trueExtensionForearmDirWorld": { "$ref": "#/definitions/vec3" }, "flexionTravelDirWorld": { "$ref": "#/definitions/vec3" } } },
    "controller": { "type": "object", "required": ["node", "localAxis", "drives"], "properties": { "node": { "type": "string" }, "localAxis": { "const": "+X" }, "drives": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "dofs": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "axis", "min", "max", "neutral", "unit", "rangeStatus"],
      "properties": { "id": { "type": "string" }, "axis": { "enum": ["+X", "-X", "+Y", "-Y", "+Z", "-Z"] }, "min": { "type": "number" }, "max": { "type": "number" }, "neutral": { "type": "number" }, "unit": { "const": "deg" } } } },
    "semantics": { "type": "object", "required": ["neutral_definition", "neutral_offset_deg", "neutral_offset_method", "source_pose_flexion_deg", "source_pose_reference", "range_status", "range_reference_status", "user_facing_dofs"],
      "properties": { "neutral_offset_deg": { "type": "number" }, "source_pose_flexion_deg": { "type": "number" }, "user_facing_dofs": { "type": "array", "items": { "type": "string" } } } },
    "structures": { "type": "array", "minItems": 1, "items": { "type": "object",
      "required": ["structureId", "label", "role", "tier", "side", "nodeName", "meshName", "triangles", "attachTo", "motionBehavior", "group", "neutralWorldBBox", "neutralWorldMatrix", "source"],
      "properties": { "structureId": { "type": "string" }, "role": { "enum": ["bone_fixed", "bone_moving", "follow", "tracked", "spanning_soft", "attached_soft", "context"] },
                      "tier": { "enum": ["core", "detail", "context"] }, "triangles": { "type": "integer", "minimum": 1 }, "attachTo": { "type": ["string", "null"] },
                      "neutralWorldBBox": { "type": "object", "required": ["min", "max"], "properties": { "min": { "$ref": "#/definitions/vec3" }, "max": { "$ref": "#/definitions/vec3" } } },
                      "neutralWorldMatrix": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "type": "number" } },
                      "source": { "type": "object", "required": ["object", "mesh", "fileSha256"], "properties": { "fileSha256": { "$ref": "#/definitions/sha256" } } } } } },
    "anchors": { "type": "array", "items": { "type": "object",
      "required": ["anchorId", "key", "nodeName", "tier", "structureId", "label", "anchorType", "precision", "displayCategory", "motionBehavior", "parentNode", "export", "neutralWorldPosition", "blenderLocalPosition", "labelDirectionLocalBlender", "visibility"],
      "properties": { "tier": { "enum": ["core", "detail", "context"] }, "export": { "type": "boolean" }, "neutralWorldPosition": { "$ref": "#/definitions/vec3" }, "blenderLocalPosition": { "$ref": "#/definitions/vec3" },
                      "band": { "type": "object", "required": ["representation", "deformationSimulation"], "properties": { "representation": { "const": "schematic" }, "deformationSimulation": { "const": false } } } } } },
    "bands": { "type": "array", "items": { "type": "object", "required": ["bandId", "structureId", "representation", "deformationSimulation", "proximalAnchorId", "distalAnchorId", "realLigamentMesh", "contentLabel"],
      "properties": { "representation": { "const": "schematic" }, "deformationSimulation": { "const": false } } } },
    "bandRepresentation": { "type": "object", "required": ["representation", "deformationSimulation", "statement"], "properties": { "representation": { "const": "schematic" }, "deformationSimulation": { "const": false } } },
    "tiers": { "type": "object", "required": ["core", "detail", "context"], "additionalProperties": false,
      "patternProperties": { "^(core|detail|context)$": { "type": "object",
        "required": ["url", "nodes", "structureIds", "triangles", "bytes", "sha256", "gzipBytes", "brotliBytes", "embeddedTextureBytes", "gzipBytesExcludingTextures", "rawSha256", "extensionsRequired", "textures", "loadTrigger"],
        "properties": { "url": { "type": "string", "pattern": "^[a-z0-9_]+\\.(core|detail|context)\\.glb$" }, "sha256": { "$ref": "#/definitions/sha256" }, "bytes": { "type": "integer", "minimum": 1 },
                        "extensionsRequired": { "type": "array", "items": { "type": "string" }, "not": { "contains": { "const": "KHR_draco_mesh_compression" } } } } } } },
    "budgetsKB": { "type": "object", "required": ["coreKB", "detailKB", "contextKB"] },
    "source": { "type": "object", "required": ["file", "scene", "sha256", "workingFileSha256"], "properties": { "sha256": { "$ref": "#/definitions/sha256" }, "workingFileSha256": { "$ref": "#/definitions/sha256" } } },
    "sharedTextures": { "type": "object", "required": ["unique", "uniqueBytes", "budgetKB"] }
  },
  "definitions": {
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
